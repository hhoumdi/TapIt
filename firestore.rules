rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{cardId} {
      // Anyone can read profiles upon scanning NFC
      allow read: if true;
      
      // Allow updates during setup or dashboard edit
      allow create, update: if request.resource.data.status in ['active', 'inactive', 'pending_validation'];
      
      // Prevent client deletion
      allow delete: if false;
    }
  }
}
